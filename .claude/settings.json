{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.ovpn)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command",
        "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/abas\" hook-start 2>/dev/null; exit 0",
        "timeout": 10 },
        { "type": "command",
          "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/heartbeat\" 2>/dev/null; exit 0",
          "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command",
          "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/auto-commit\" >/dev/null 2>&1; exit 0",
          "timeout": 15 },
        { "type": "command",
          "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/abas\" hook-end 2>/dev/null; exit 0",
          "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [
        { "type": "command",
          "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/retomada\" 2>/dev/null; exit 0",
          "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [
        { "type": "command",
          "if": "Bash(git *)",
          "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/abas\" portao 2>/dev/null; exit 0",
          "timeout": 10,
          "statusMessage": "portão de abas" } ] },
      { "matcher": "Write",
        "hooks": [
        { "type": "command",
          "command": "[ -n \"$CLAUDE_PROJECT_DIR\" ] || exit 0; \"$CLAUDE_PROJECT_DIR/.claude/bin/abas\" portao 2>/dev/null; exit 0",
          "timeout": 10,
          "statusMessage": "portão de abas" } ] }
    ]
  }
}
